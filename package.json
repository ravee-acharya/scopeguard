{
  "name": "scopeguard",
  "version": "1.0.0",
  "private": true,
  "description": "ScopeGuard - detects mid-sprint scope creep (shadow work) in Jira Cloud and makes it accountable.",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "forge lint",
    "check": "npm run ci && forge lint",
    "deploy": "forge deploy -e development --non-interactive",
    "tunnel": "forge tunnel",
    "ci": "npm run typecheck && npm test",
    "manifest:dash": "node scripts/make-edition-manifest.mjs editions/dash-internal.json"
  },
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/bridge": "^7.3.0",
    "@forge/kvs": "^2.1.2",
    "@forge/react": "^12.5.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
